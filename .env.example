# Copy to .env (ignored by git) and fill with a Kraken API key: read by docker compose, and by the
# live dry run of the bot:
#   cargo test -p kraken-trading-bot --test live_dry_run -- --ignored --test-threads=1
#
# Permissions to give to the key: Query Funds, Query Open Orders & Trades,
# Query Closed Orders & Trades, Create & Modify Orders. Never Withdraw Funds.
KRAKEN_API_KEY=
# the "Private Key" given by Kraken, in base64
KRAKEN_API_SECRET=

# Several Kraken accounts running the same managers: their names, then the key of each one but the
# first. Never two keys of one account
# KRAKEN_BOT_ACCOUNTS=main,alice
# KRAKEN_API_KEY_ALICE=
# KRAKEN_API_SECRET_ALICE=

# Notifications on the phone, with the ntfy app: the topic it subscribes to. Whoever knows it reads
# the notifications: make it long and random, e.g. `openssl rand -hex 16`
KRAKEN_BOT_NTFY_TOPIC=
# only for a protected topic (self-hosted ntfy, or a reserved topic of ntfy.sh)
KRAKEN_BOT_NTFY_TOKEN=
